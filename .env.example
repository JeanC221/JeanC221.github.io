# ==========================================
# Environment Variables Template
# ==========================================
# Application Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database Connection (Parameterized, never expose credentials)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname?schema=public

# Authentication & JWT Secrets (Min 32 random characters in production)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_32_chars
COOKIE_SECRET=replace_with_cookie_signing_secret

# Observability & Monitoring (Sentry / LogRocket)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
LOG_LEVEL=info

# Third-Party Integrations
# API_KEY_EXAMPLE=your_api_key_here